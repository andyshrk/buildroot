From 05b29771f5d654f4f2af8af08fa2eca15edcc95c Mon Sep 17 00:00:00 2001
From: Andy Yan <andy.yan@rock-chips.com>
Date: Wed, 11 Jun 2025 15:31:52 +0800
Subject: [PATCH 2/2] drm/panel: raydium-rm67200: Set display on at prepare
 stage

Signed-off-by: Andy Yan <andy.yan@rock-chips.com>
---
 drivers/gpu/drm/panel/panel-raydium-rm67200.c | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-raydium-rm67200.c b/drivers/gpu/drm/panel/panel-raydium-rm67200.c
index 64b685dc11f65..205273163cb97 100644
--- a/drivers/gpu/drm/panel/panel-raydium-rm67200.c
+++ b/drivers/gpu/drm/panel/panel-raydium-rm67200.c
@@ -318,8 +318,11 @@ static void w552793baa_setup(struct mipi_dsi_multi_context *ctx)
 static int raydium_rm67200_prepare(struct drm_panel *panel)
 {
 	struct raydium_rm67200 *ctx = to_raydium_rm67200(panel);
+	struct mipi_dsi_multi_context mctx = { .dsi = ctx->dsi };
 	int ret;
 
+
+	dev_info(panel->dev, "%s\n", __func__);
 	ret = regulator_bulk_enable(ctx->num_supplies, ctx->supplies);
 	if (ret < 0)
 		return ret;
@@ -328,6 +331,12 @@ static int raydium_rm67200_prepare(struct drm_panel *panel)
 
 	msleep(60);
 
+	ctx->panel_info->panel_setup(&mctx);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&mctx);
+	mipi_dsi_msleep(&mctx, 120);
+	mipi_dsi_dcs_set_display_on_multi(&mctx);
+	mipi_dsi_msleep(&mctx, 30);
+
 	return 0;
 }
 
@@ -348,12 +357,8 @@ static int raydium_rm67200_enable(struct drm_panel *panel)
 	struct raydium_rm67200 *rm67200 = to_raydium_rm67200(panel);
 	struct mipi_dsi_multi_context ctx = { .dsi = rm67200->dsi };
 
-	rm67200->panel_info->panel_setup(&ctx);
-	mipi_dsi_dcs_exit_sleep_mode_multi(&ctx);
-	mipi_dsi_msleep(&ctx, 120);
-	mipi_dsi_dcs_set_display_on_multi(&ctx);
-	mipi_dsi_msleep(&ctx, 30);
 
+	dev_info(panel->dev, "%s\n", __func__);
 	return ctx.accum_err;
 }
 
-- 
